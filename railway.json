{
	"$schema": "https://railway.com/railway.schema.json",
	"build": {
		"builder": "RAILPACK",
		"buildCommand": "pnpm run build && cp -r public .next/standalone/ && cp -r .next/static .next/standalone/.next/",
		"watchPatterns": [
			"/**",
			"!/**/*.md",
			"!/docs/**",
			"!/tests/**",
			"!/pocketbase/**",
			"!/.husky/**"
		]
	},
	"deploy": {
		"startCommand": "HOSTNAME=0.0.0.0 node .next/standalone/server.js",
		"restartPolicyType": "ON_FAILURE",
		"restartPolicyMaxRetries": 10
	}
}
