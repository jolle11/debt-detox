{
	"$schema": "https://railway.com/railway.schema.json",
	"build": {
		"builder": "RAILPACK",
		"buildCommand": "pnpm run build && cp -r public .next/standalone/ && cp -r .next/static .next/standalone/.next/",
		"watchPatterns": [
			"/app/**",
			"/components/**",
			"/contexts/**",
			"/data/**",
			"/hooks/**",
			"/i18n/**",
			"/lib/**",
			"/messages/**",
			"/public/**",
			"/utils/**",
			"/proxy.ts",
			"/next.config.ts",
			"/package.json",
			"/pnpm-lock.yaml",
			"/tsconfig.json",
			"/postcss.config.*",
			"/railway.json",
			"/.dockerignore"
		]
	},
	"deploy": {
		"startCommand": "HOSTNAME=0.0.0.0 node .next/standalone/server.js",
		"restartPolicyType": "ON_FAILURE",
		"restartPolicyMaxRetries": 10
	}
}
